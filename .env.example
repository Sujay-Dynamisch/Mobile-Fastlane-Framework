# =============================================================================
# Android / Firebase
# =============================================================================
# e.g. your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_CREDENTIALS_FILE=

# Preferred when Firebase App Testing agent is enabled: output of `firebase login:ci`
FIREBASE_TOKEN=
FIREBASE_ANDROID_DEV_APP_ID=
FIREBASE_ANDROID_DEV_GROUPS=
FIREBASE_ANDROID_STAGING_APP_ID=
FIREBASE_ANDROID_STAGING_GROUPS=
FIREBASE_ANDROID_UAT_APP_ID=
FIREBASE_ANDROID_UAT_GROUPS=
FIREBASE_ANDROID_PROD_APP_ID=
FIREBASE_ANDROID_PROD_GROUPS=

# Optional direct tester emails. Comma-separated.
# FIREBASE_ANDROID_STAGING_TESTERS=qa1@example.com,qa2@example.com

# Optional login used by the Firebase App Testing agent when a test case signs in
FIREBASE_TEST_USERNAME=
FIREBASE_TEST_PASSWORD=

# =============================================================================
# Release metadata (optional)
# =============================================================================
VERSION_NAME=
BUILD_NUMBER=
RELEASE_NOTES=
RELEASE_NOTES_FILE=

# =============================================================================
# Microsoft Teams
# =============================================================================
TEAMS_WEBHOOK_URL=

# =============================================================================
# Email (App Testing agent test reports)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TEST_ALERT_EMAIL_RECIPIENTS=

# =============================================================================
# iOS / App Store Connect
# =============================================================================
# 10-character Apple Developer Team ID (used for signing)
APPLE_TEAM_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_FILE=
# APP_STORE_CONNECT_KEY_CONTENT=

# =============================================================================
# iOS Match
# =============================================================================
MATCH_GIT_URL=
MATCH_GIT_BRANCH=main
MATCH_PASSWORD=

# =============================================================================
# Firebase CLI token required to automate the Agent Test Cases.
# =============================================================================
FIREBASE_TOKEN=